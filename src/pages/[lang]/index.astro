---
import type { GetStaticPaths } from 'astro';
import HomeSections from '../../components/HomeSections.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLocale, isLocale, locales, type Locale } from '../../i18n/utils';

export const prerender = true;

// English is served unprefixed by src/pages/index.astro.
export const getStaticPaths = (() =>
  locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { lang: locale } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
if (!isLocale(lang)) {
  throw new Error(`Unknown locale "${lang}"`);
}
const locale: Locale = lang;
---

<BaseLayout locale={locale}>
  <HomeSections locale={locale} />
</BaseLayout>
