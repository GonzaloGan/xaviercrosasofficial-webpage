---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { site } from '../data/site';
import { useTranslations, type UIKey } from '../i18n/ui';
import { localisePath, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localisePath('/', locale);

/**
 * The single definition of the navigation. The previous implementation kept the
 * labels and the anchor ids in two separate positional arrays, duplicated across
 * the desktop and mobile menus, so reordering one silently mislabelled the other.
 */
const navItems = [
  { id: 'home', key: 'nav.home' },
  { id: 'music', key: 'nav.music' },
  { id: 'videos', key: 'nav.videos' },
  { id: 'about', key: 'nav.about' },
  { id: 'contact', key: 'nav.contact' },
] as const satisfies readonly { id: string; key: UIKey }[];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-surface/80 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 lg:px-8">
    <a href={home} class="text-sm uppercase tracking-label text-white/80 transition hover:text-white">
      {site.name}
    </a>

    <nav aria-label={t('nav.home')} class="hidden items-center gap-7 md:flex">
      {
        navItems.map((item) => (
          <a href={`${home}#${item.id}`} class="text-sm text-white/70 transition hover:text-white">
            {t(item.key)}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher locale={locale} class="hidden sm:flex" />
      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('a11y.openMenu')}
        data-label-open={t('a11y.openMenu')}
        data-label-close={t('a11y.closeMenu')}
        class="rounded-full border border-white/15 bg-white/5 p-2.5 text-white transition hover:bg-white/10 md:hidden"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="border-t border-white/10 bg-surface md:hidden">
    <nav aria-label={t('nav.home')} class="mx-auto flex max-w-7xl flex-col gap-1 px-5 py-4">
      {
        navItems.map((item) => (
          <a
            href={`${home}#${item.id}`}
            class="rounded-card px-3 py-2.5 text-base text-white/80 transition hover:bg-white/5 hover:text-white"
          >
            {t(item.key)}
          </a>
        ))
      }
      <LanguageSwitcher locale={locale} class="mt-2 px-3 sm:hidden" />
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const focusableSelector = 'a[href], button:not([disabled])';

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (label) toggle.setAttribute('aria-label', label);
      if (open) {
        menu.querySelector<HTMLElement>(focusableSelector)?.focus();
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.hidden);
    });

    menu.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (menu.hidden) return;

      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }

      if (event.key !== 'Tab') return;

      // Keep focus inside the open menu.
      const focusable = [toggle, ...menu.querySelectorAll<HTMLElement>(focusableSelector)];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
