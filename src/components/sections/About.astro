---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { Locale } from '../../i18n/utils';

interface Props {
  bio: CollectionEntry<'bio'>;
  locale: Locale;
}

const { bio } = Astro.props;
const { Content } = await render(bio);
---

<section id="about" class="mx-auto max-w-7xl px-5 py-10 lg:px-8 lg:py-14">
  <div class="grid gap-6 rounded-panel border border-white/10 bg-white/5 p-6 sm:p-8 lg:grid-cols-3">
    <div>
      <h2 class="text-3xl font-semibold tracking-display">{bio.data.heading}</h2>
      <p class="mt-3 text-sm text-white/45">{bio.data.role}</p>
      <p class="mt-1 text-sm text-white/45">{bio.data.location}</p>
    </div>

    <div class="prose-invert max-w-none text-white/70 lg:col-span-2 [&_p]:leading-7">
      <Content />
    </div>
  </div>
</section>
