---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { useTranslations } from '../../i18n/ui';
import type { Locale } from '../../i18n/utils';

interface Props {
  release: CollectionEntry<'releases'>;
  locale: Locale;
}

const { release, locale } = Astro.props;
const { title, cover, coverAlt, credits, releaseDate, featured, links } = release.data;
const t = useTranslations(locale);
---

<article id={release.id} class="overflow-hidden rounded-panel border border-white/10 bg-white/5">
  <Image
    src={cover}
    alt={coverAlt[locale]}
    widths={[400, 800]}
    sizes="(min-width: 1024px) 33vw, 100vw"
    loading="lazy"
    class="h-72 w-full object-cover"
  />

  <div class="p-6 sm:p-8">
    <p class="text-xs uppercase tracking-label text-white/45">
      {featured ? t('music.featured') : credits}
    </p>

    <h3 class="mt-3 text-3xl font-semibold tracking-display">{title}</h3>

    <p class="mt-3 max-w-xl text-white/70">
      <time datetime={releaseDate.toISOString().slice(0, 10)}>{releaseDate.getFullYear()}</time>
      {featured ? ` · ${credits}` : ''}
    </p>

    <div class="mt-5 flex flex-wrap gap-3">
      {
        links.spotify && (
          <a
            href={links.spotify}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white px-5 py-3 text-sm font-medium text-black transition hover:scale-[1.02]"
          >
            <Icon name="music" />
            {t('music.streaming')}
            <span class="sr-only">
              — {title} ({t('a11y.opensInNewTab')})
            </span>
          </a>
        )
      }

      {
        links.youtube && (
          <a
            href={links.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-3 text-sm font-medium text-white transition hover:bg-white/10"
          >
            <Icon name="arrow-up-right" />
            {t('music.video')}
            <span class="sr-only">
              — {title} ({t('a11y.opensInNewTab')})
            </span>
          </a>
        )
      }
    </div>
  </div>
</article>
