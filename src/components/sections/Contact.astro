---
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import { useTranslations } from '../../i18n/ui';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="contact" class="mx-auto max-w-7xl px-5 py-10 lg:px-8 lg:py-16">
  <div class="rounded-panel border border-white/10 bg-white/5 p-6 sm:p-10">
    <p class="text-xs uppercase tracking-label text-white/45">{t('contact.cta')}</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-display sm:text-4xl">{t('contact.heading')}</h2>
    <p class="mt-3 max-w-xl text-white/70">{t('contact.body')}</p>

    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href={`mailto:${site.email}`}
        data-obfuscation="1"
        class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-medium text-black transition hover:scale-[1.02]"
      >
        <Icon name="mail" />
        {t('contact.email')}
      </a>

      <a
        href={site.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-3 text-sm font-medium text-white transition hover:bg-white/10"
      >
        <Icon name="instagram" />
        Instagram
        <span class="sr-only">({t('a11y.opensInNewTab')})</span>
      </a>

      <a
        href={site.social.youtube}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-3 text-sm font-medium text-white transition hover:bg-white/10"
      >
        <Icon name="youtube" />
        YouTube
        <span class="sr-only">({t('a11y.opensInNewTab')})</span>
      </a>
    </div>
  </div>
</section>
