---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import heroPortrait from '../../assets/images/xavi1.webp';
import { site } from '../../data/site';
import { useTranslations } from '../../i18n/ui';
import { localisePath, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
  role: string;
  location: string;
  portraitAlt: string;
}

const { locale, role, location, portraitAlt } = Astro.props;
const t = useTranslations(locale);
const home = localisePath('/', locale);

const facts = [
  { label: t('a11y.language'), value: 'EN · ES · CA · NL' },
  { label: t('contact.heading'), value: location },
] as const;
---

<section id="home" class="mx-auto grid max-w-7xl gap-6 px-5 py-10 lg:grid-cols-2 lg:px-8 lg:py-16">
  <div class="flex flex-col justify-center">
    <p class="text-xs uppercase tracking-label text-white/45">{t('hero.kicker')}</p>

    <h1 class="mt-4 text-4xl font-bold tracking-display sm:text-5xl lg:text-6xl">
      {t('hero.title')}
    </h1>

    <p class="mt-5 max-w-xl text-white/70">{role}</p>

    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href={site.social.spotify}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-medium text-black transition hover:scale-[1.02]"
      >
        <Icon name="play" />
        {t('hero.primary')}
        <span class="sr-only">({t('a11y.opensInNewTab')})</span>
      </a>

      <a
        href={`${home}#videos`}
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-3 text-sm font-medium text-white transition hover:bg-white/10"
      >
        <Icon name="arrow-up-right" />
        {t('hero.secondary')}
      </a>
    </div>

    <dl class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        facts.map((fact) => (
          <div class="rounded-card border border-white/10 bg-white/5 p-4">
            <dt class="text-xs uppercase tracking-label text-white/45">{fact.label}</dt>
            <dd class="mt-3 text-lg text-white">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="relative overflow-hidden rounded-panel border border-white/10 bg-white/5">
    <Image
      src={heroPortrait}
      alt={portraitAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      loading="eager"
      class="h-full w-full object-cover opacity-90"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/5 to-black/10"></div>
    <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
      <div class="max-w-sm rounded-card border border-white/10 bg-black/60 p-5 backdrop-blur-xl">
        <p class="text-2xl font-semibold tracking-display">{site.name}</p>
        <p class="mt-2 text-sm leading-6 text-white/70">{t('hero.body')}</p>
      </div>
    </div>
  </div>
</section>
