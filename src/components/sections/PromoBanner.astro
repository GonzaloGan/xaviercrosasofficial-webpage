---
import { site } from '../../data/site';
import { useTranslations } from '../../i18n/ui';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const promo = site.promoBanner;
---

{
  promo.enabled && (
    <section class="mx-auto max-w-7xl px-5 pt-6 lg:px-8" aria-label={t('promo.kicker')}>
      <div class="rounded-panel border border-white/30 bg-gradient-to-r from-white/20 via-white/10 to-white/20 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.45)] sm:p-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs uppercase tracking-label text-white/55">{t('promo.kicker')}</p>
            <h2 class="mt-2 text-2xl font-semibold tracking-display sm:text-3xl">{promo.albumTitle}</h2>
            <p class="mt-3 max-w-2xl text-sm text-white/75 sm:text-base">{t('promo.body')}</p>
          </div>

          <div class="flex flex-col gap-3 sm:items-end">
            <a
              href={promo.spotifyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-full bg-white px-5 py-3 text-sm font-semibold text-black transition hover:scale-[1.02] hover:bg-white/90"
            >
              {t('promo.cta')}
              <span class="sr-only">({t('a11y.opensInNewTab')})</span>
            </a>

            <a
              href="https://linktr.ee/xaviercrosasofficial"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-full bg-white px-5 py-3 text-sm font-semibold text-black transition hover:scale-[1.02] hover:bg-white/90"
            >
              {t('promo.secondaryCta')}
              <span class="sr-only">({t('a11y.opensInNewTab')})</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}
