---
import { getEntry } from 'astro:content';
import About from './sections/About.astro';
import Contact from './sections/Contact.astro';
import Hero from './sections/Hero.astro';
import Music from './sections/Music.astro';
import Videos from './sections/Videos.astro';
import { site } from '../data/site';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const bio = await getEntry('bio', locale);
if (!bio) {
  throw new Error(`Missing biography for locale "${locale}" — expected src/content/bio/${locale}.md`);
}
---

<Hero
  locale={locale}
  role={bio.data.role}
  location={bio.data.location}
  portraitAlt={`${site.name} — ${bio.data.role}`}
/>
<Music locale={locale} />
<Videos locale={locale} />
<About bio={bio} locale={locale} />
<Contact locale={locale} />
